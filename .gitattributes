*.sqlite3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.db filter=lfs diff=lfs merge=lfs -text

# Web-sized copies the templates use (static/media). Plain git objects, not
# LFS, so hosts that do not fetch LFS (Vercel by default) still get them.
project/website/static/media/*.mp4 -filter binary
